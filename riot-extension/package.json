{
  "name": "riot-python-environments",
  "publisher": "florentinl",
  "displayName": "Riot Python Environments",
  "description": "Python Environments extension plugin for Datadog's Riot venv manager",
  "version": "1.5.0",
  "repository": "https://github.com/florentinl/rt.git",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/riotfile.py"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "riot.forceReinstallEnvironment",
        "title": "Force Reinstall Selected Environment",
        "category": "Riot"
      },
      {
        "command": "riot.refreshVenvIndicators",
        "title": "Refresh Riot Venv Indicators",
        "category": "Riot"
      },
      {
        "command": "riot.selectActiveFileVenv",
        "title": "Select Riot Environment for Current File",
        "category": "Riot"
      }
    ]
  },
  "scripts": {
    "dist": "npm run package && npm run build-runtime && vsce package",
    "build-runtime": "bash ./build-runtime.sh",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "test:unit": "npm run compile-tests && node --test out/test/packageMetadata.test.js out/test/pytestTargets.test.js",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@renovatebot/pep440": "^4.2.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "extensionDependencies": [
    "ms-python.python",
    "ms-python.vscode-python-envs"
  ]
}
